<sdf version="1.4">
  <world name="puzzlebot_office_course">

      <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
        filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Arena lights -->
    <include>
    <name>light1</name>
      <uri>model://simple_light</uri>
      <pose>2 2 10 0 0 0</pose>
    </include>

    <include>
    <name>light2</name>
      <uri>model://simple_light</uri>
      <pose>-2 2 10 0 0 0</pose>
    </include>
    
    <include>
    <name>light3</name>
      <uri>model://simple_light</uri>
      <pose>-2 -2 10 0 0 0</pose>
    </include>

    <include>
    <name>light4</name>
      <uri>model://simple_light</uri>
      <pose>2 -2 10 0 0 0</pose>
    </include>

    <include>
      <uri>model://office_floor</uri>
    </include>

    <include>
      <uri>model://office_model</uri>
    </include>

    <include>
      <name>goal_marker_0</name>
      <uri>model://goal_marker_5</uri>
      <pose>2.7 -1.3 0.01 0 0 0</pose>
    </include>

    <include>
      <name>goal_marker_1</name>
      <uri>model://goal_marker_5</uri>
      <pose>-2.8 0.4 0.01 0 0 0</pose>
    </include>

    <include>
      <name>goal_marker_2</name>
      <uri>model://goal_marker_5</uri>
      <pose>-2.8 3.7 0.01 0 0 0</pose>
    </include>

    <include>
      <name>goal_marker_3</name>
      <uri>model://goal_marker_5</uri>
      <pose>4.3 3.7 0.01 0 0 0</pose>
    </include>

    <include>
      <name>marker_0</name>
      <uri>model://aruco_marker_0</uri>
      <pose>-1.80 -2.20 0.091 0 0 3.141592654</pose>
    </include>

    <include>
      <name>marker_1</name>
      <uri>model://aruco_marker_1</uri>
      <pose>3.85 -1.50 0.091 0 0 3.141592654</pose>
    </include>

    <include>
      <name>marker_2</name>
      <uri>model://aruco_marker_2</uri>
      <pose>-3.85 0.20 0.091 0 0 0</pose>
    </include>

    <include>
      <name>marker_3</name>
      <uri>model://aruco_marker_3</uri>
      <pose>-3.85 3.50 0.091 0 0 0</pose>
    </include>

    <include>
      <name>marker_4</name>
      <uri>model://aruco_marker_4</uri>
      <pose>3.85 3.30 0.091 0 0 3.141592654</pose>
    </include>

    <include>
      <name>marker_5</name>
      <uri>model://aruco_marker_5</uri>
      <pose>-2.15 2.80 0.091 0 0 3.141592</pose>
    </include>

    <include>
      <name>marker_6</name>
      <uri>model://aruco_marker_6</uri>
      <pose>3.30 3.35 0.091 0 0 3.141592</pose>
    </include>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>-8.0 -8.0 10.0 0 0.785 0.785</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>