<?xml version="1.0"?>
<robot name="puzzlebot">

  <!-- ══════════════════════════════════════════════════════
       LINKS
  ══════════════════════════════════════════════════════════ -->

  <!-- Link raíz — plano del suelo, sin geometría física -->
  <link name="base_footprint"/>

  <!-- Chasis principal -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://puzzlebot_sim/meshes/Puzzlebot_Jetson_Lidar_Edition_Base.stl"/>
      </geometry>
      <material name="yellow"><color rgba="0.8 0.7 0.0 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.20 0.16 0.0503"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.351"/>
      <inertia ixx="0.001109" ixy="0" ixz="0"
               iyy="0.001415" iyz="0"
               izz="0.002243"/>
    </inertial>
  </link>

  <!-- Rueda derecha -->
  <link name="wheel_r">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://puzzlebot_sim/meshes/Puzzlebot_Wheel.stl"/>
      </geometry>
      <material name="red"><color rgba="1.0 0 0 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.012"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="0.027"/>
      <inertia ixx="0.000017" ixy="0" ixz="0"
               iyy="0.000017" iyz="0"
               izz="0.000033"/>
    </inertial>
  </link>

  <!-- Rueda izquierda -->
  <link name="wheel_l">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://puzzlebot_sim/meshes/Puzzlebot_Wheel.stl"/>
      </geometry>
      <material name="blue"><color rgba="0 0 1.0 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.012"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="0.027"/>
      <inertia ixx="0.000017" ixy="0" ixz="0"
               iyy="0.000017" iyz="0"
               izz="0.000033"/>
    </inertial>
  </link>

  <!-- Rueda loca (caster) -->
  <link name="caster">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://puzzlebot_sim/meshes/Puzzlebot_Caster_Wheel.stl"/>
      </geometry>
      <material name="black"><color rgba="0 0 0 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.0065"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.009"/>
      <inertia ixx="0.000001" ixy="0" ixz="0"
               iyy="0.000001" iyz="0"
               izz="0.000001"/>
    </inertial>
  </link>

  <!-- Tarjeta NVIDIA Jetson -->
  <link name="jetson_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://puzzlebot_sim/meshes/NVIDIA_Jetson.stl"/>
      </geometry>
      <material name="green"><color rgba="0.0 0.5 0.2 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.079 0.1 0.028"/></geometry>
    </collision>
    <inertial>
      <mass value="0.131"/>
      <inertia ixx="0.000107" ixy="0" ixz="0"
               iyy="0.000086" iyz="0"
               izz="0.000172"/>
    </inertial>
  </link>

  <!-- Soporte del bracket de cámara/LiDAR -->
  <link name="bracket_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://puzzlebot_sim/meshes/Laser_Camera_Bracket.stl"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0.018 0 0.005" rpy="0 0 0"/>
      <geometry><box size="0.046 0.030 0.045"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.018 0 0.005" rpy="0 0 0"/>
      <mass value="0.035"/>
      <inertia ixx="0.000007" ixy="0" ixz="0"
               iyy="0.000004" iyz="0"
               izz="0.000005"/>
    </inertial>
  </link>

  <!-- Link de la cámara -->
  <link name="camera_link">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.005 0.005 0.005"/></geometry>
    </collision>
    <inertial>
      <mass value="0.00001"/>
      <inertia ixx="0.000000001" ixy="0" ixz="0"
               iyy="0.000000001" iyz="0"
               izz="0.000000001"/>
    </inertial>
  </link>

  <!-- Link óptico de la cámara (ejes OpenCV) -->
  <link name="camera_link_optical">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.005 0.005 0.005"/></geometry>
    </collision>
    <inertial>
      <mass value="0.00001"/>
      <inertia ixx="0.000000001" ixy="0" ixz="0"
               iyy="0.000000001" iyz="0"
               izz="0.000000001"/>
    </inertial>
  </link>

  <!-- Base del LiDAR -->
  <link name="lidar_base_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://puzzlebot_sim/meshes/RPLidar.stl"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.021" rpy="0 0 0"/>
      <geometry><box size="0.08 0.07 0.05"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.021" rpy="0 0 0"/>
      <mass value="0.1755"/>
      <inertia ixx="0.000117" ixy="0" ixz="0"
               iyy="0.000139" iyz="0"
               izz="0.000199"/>
    </inertial>
  </link>

  <!-- Frame del LiDAR (sensor) -->
  <link name="laser_frame">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.005 0.005 0.005"/></geometry>
    </collision>
    <inertial>
      <mass value="0.00001"/>
      <inertia ixx="0.000000001" ixy="0" ixz="0"
               iyy="0.000000001" iyz="0"
               izz="0.000000001"/>
    </inertial>
  </link>

  <!-- ══════════════════════════════════════════════════════
       JOINTS
  ══════════════════════════════════════════════════════════ -->

  <joint name="base_link_joint" type="fixed">
    <origin xyz="0.0 0.0 0.05" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <joint name="wheel_r_joint" type="continuous">
    <origin xyz="0.052 -0.095 -0.0025" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="wheel_r"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="wheel_l_joint" type="continuous">
    <origin xyz="0.052 0.095 -0.0025" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="wheel_l"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="caster_joint" type="fixed">
    <origin xyz="-0.095 0.0 -0.043" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="caster"/>
  </joint>

  <joint name="jetson_joint" type="fixed">
    <origin xyz="0.035 -0.003 0.02515" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="jetson_link"/>
  </joint>

  <joint name="camera_base_joint" type="fixed">
    <origin xyz="0.104 0.0 0.022" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="bracket_base_link"/>
  </joint>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.0201 0.0 0.045" rpy="0 0 0"/>
    <parent link="bracket_base_link"/>
    <child link="camera_link"/>
  </joint>

  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
  </joint>

  <joint name="lidar_base_joint" type="fixed">
    <origin xyz="0.0425 0.0 0.070" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_base_link"/>
  </joint>

  <joint name="lidar_joint" type="fixed">
    <origin xyz="0.0 0.0 0.035" rpy="0 0 0"/>
    <parent link="lidar_base_link"/>
    <child link="laser_frame"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════
       PLUGINS DE GAZEBO
  ══════════════════════════════════════════════════════════ -->

  <!-- Plugin de movimiento diferencial (encoders + cmd_vel) -->
  <gazebo>
    <plugin name="DiffDynamicPlugin" filename="libDiffDynamicPlugin.so">
      <leftJoint>wheel_l_joint</leftJoint>
      <rightJoint>wheel_r_joint</rightJoint>
      <cmd_vel_topic>cmd_vel</cmd_vel_topic>
      <enc_R_topic>VelocityEncR</enc_R_topic>
      <enc_L_topic>VelocityEncL</enc_L_topic>
      <cmd_R_topic>VelocitySetR</cmd_R_topic>
      <cmd_L_topic>VelocitySetL</cmd_L_topic>
      <robot_vel_topic>robot_vel</robot_vel_topic>
      <mot_Vmax>5</mot_Vmax>
      <mot_J>0.0005</mot_J>
      <mot_R>2</mot_R>
      <mot_L>0.01</mot_L>
      <mot_K>0.01</mot_K>
      <mot_b>0.00001</mot_b>
      <mot_gear>34</mot_gear>
      <robot_width>0.19</robot_width>
      <wheel_radius>0.05</wheel_radius>
      <pid_Kp>0.1</pid_Kp>
      <pid_Ti>0.05</pid_Ti>
      <pid_Td>0</pid_Td>
      <input_type>1</input_type>
      <rate>100</rate>
    </plugin>

    <!-- Plugin de joint states para animación de ruedas -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <update_rate>50</update_rate>
      <joint_name>wheel_r_joint</joint_name>
      <joint_name>wheel_l_joint</joint_name>
    </plugin>

    <!-- Plugin de odometría ground truth -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>ground_truth</odom_topic>
      <tf_topic>tf</tf_topic>
      <dimensions>2</dimensions>
    </plugin>
  </gazebo>

  <!-- Sensor LiDAR -->
  <gazebo reference="laser_frame">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>laser_frame</gz_frame_id>
      <pose>0 0 0 0 0 0</pose>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.283185</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>0.01</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.017</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

  <!-- Sensor Cámara RGB -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="camera_sensor">
      <pose>0 0 0 0 0 0</pose>
      <topic>camera</topic>
      <camera>
        <camera_info_topic>camera_info</camera_info_topic>
        <horizontal_fov>1.089</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>8.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <always_on>1</always_on>
      <gz_frame_id>camera_link_optical</gz_frame_id>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

</robot>
